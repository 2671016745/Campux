<app-header tenant-name="{{tenantName}}" logo-url="{{logoUrl}}" role-label="{{roleLabel}}"></app-header>

<view class="screen">
  <view class="section-title">账户设置</view>
  <view class="section-sub">管理你在当前校园墙里的基本账号信息。</view>

  <view class="surface rows">
    <view class="row" bindtap="renameAccount">
      <view class="row-text">
        <view class="row-title">修改名称</view>
        <view class="row-desc">更新投稿时使用的显示名</view>
      </view>
      <view class="row-chevron icon" style="background-image: url('{{icons.chevronDown.gray}}')"></view>
    </view>
    <view class="row-divider"></view>
    <view class="row" bindtap="changePasswordHint">
      <view class="row-text">
        <view class="row-title">修改密码</view>
        <view class="row-desc">保护你的校园墙账号</view>
      </view>
      <view class="row-chevron icon" style="background-image: url('{{icons.chevronDown.gray}}')"></view>
    </view>
    <view class="row-divider"></view>
    <view class="row" bindtap="showRules">
      <view class="row-text">
        <view class="row-title">投稿规则</view>
        <view class="row-desc">查看本墙投稿规范</view>
      </view>
      <view class="row-chevron icon" style="background-image: url('{{icons.chevronDown.gray}}')"></view>
    </view>
  </view>

  <view class="section-title section-gap">账号状态</view>
  <view class="surface rows">
    <view class="row row-static">
      <view class="row-text">
        <view class="row-title">当前校园墙</view>
      </view>
      <text class="row-value">{{tenantName}}</text>
    </view>
    <view class="row-divider"></view>
    <view class="row row-static">
      <view class="row-text">
        <view class="row-title">身份</view>
      </view>
      <text class="row-value">{{roleLabel}}</text>
    </view>
    <view class="row-divider"></view>
    <view class="row row-static">
      <view class="row-text">
        <view class="row-title">账号</view>
      </view>
      <text class="row-value">{{account}}</text>
    </view>
    <view class="row-divider"></view>
    <view class="row row-static">
      <view class="row-text">
        <view class="row-title">微信绑定</view>
      </view>
      <text class="row-value">{{wechatBound ? '已绑定' : '未绑定'}}</text>
    </view>
  </view>

  <view class="btn-row">
    <view class="outline-btn" wx:if="{{!wechatBound}}" bindtap="bindWechat">绑定微信</view>
    <view class="outline-btn outline-btn-danger" wx:else bindtap="unbindWechat">解绑微信</view>
    <view class="postbtn btn-wide" bindtap="onLogout">
      <text>退出登录</text>
    </view>
  </view>

  <view class="section-title section-gap">关于服务</view>
  <view class="surface rows">
    <view class="row" bindtap="showAbout">
      <view class="row-text">
        <view class="row-title">关于</view>
        <view class="row-desc">版本、部署形态与接入信息</view>
      </view>
      <view class="row-chevron icon" style="background-image: url('{{icons.chevronDown.gray}}')"></view>
    </view>
  </view>
</view>
