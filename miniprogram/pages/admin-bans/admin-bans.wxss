/* 「封禁管理」页 —— 沿用 Campux 的信息面 + 行式列表风格 */

.screen {
  padding: 16px 16px calc(96px + env(safe-area-inset-bottom));
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #0f172b;
}

.section-sub {
  margin-top: 4px;
  margin-bottom: 12px;
  font-size: 14px;
  line-height: 20px;
  color: #62748e;
}

.section-gap {
  margin-top: 24px;
}

.surface {
  margin-top: 12px;
  overflow: hidden;
}

.rows {
  /* 已有 */
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px;
}

.row-static {
  padding: 10px 16px;
}

.row-text {
  min-width: 0;
  flex: 1;
}

.row-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #0f172b;
}

.row-desc {
  margin-top: 2px;
  font-size: 12px;
  line-height: 16px;
  color: #62748e;
  word-break: break-all;
}

.row-value {
  flex-shrink: 0;
  font-size: 14px;
  line-height: 20px;
  color: #62748e;
}

.row-chevron {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
  transform: rotate(-90deg);
}

.row-divider {
  height: 1px;
  margin-left: 16px;
  background-color: #f1f5f9;
}

.row-input {
  flex-shrink: 0;
  width: 180px;
  font-size: 14px;
  line-height: 20px;
  color: #0f172b;
  text-align: right;
}

.row-picker {
  flex-shrink: 0;
}

.picker-value {
  font-size: 14px;
  line-height: 20px;
  color: #2563eb;
}

.btn-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
}

.btn-wide {
  flex: 1;
}

/* ── 封禁卡片 ─────────────────────────────────────────────── */

.ban-card {
  padding: 12px 16px;
}

.ban-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.ban-user {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.ban-name {
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #0f172b;
}

.ban-status {
  flex-shrink: 0;
  padding: 1px 8px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 600;
  line-height: 16px;
}

.ban-status-active {
  background-color: #fef2f2;
  color: #dc2626;
}

.ban-status-ended {
  background-color: #f1f5f9;
  color: #62748e;
}

.ban-date {
  flex-shrink: 0;
  font-size: 12px;
  line-height: 16px;
  color: #94a3b8;
}

.ban-comment {
  margin-top: 6px;
  font-size: 14px;
  line-height: 20px;
  color: #45556c;
}

.ban-meta {
  margin-top: 4px;
  display: flex;
  flex-wrap: wrap;
  gap: 4px 12px;
  font-size: 12px;
  line-height: 16px;
  color: #94a3b8;
}

.ban-actions {
  margin-top: 8px;
  display: flex;
  justify-content: flex-end;
}

.unban-btn {
  padding: 4px 16px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background-color: #ffffff;
  font-size: 13px;
  font-weight: 500;
  line-height: 20px;
  color: #45556c;
}

.unban-btn:active {
  background-color: #f8fafc;
}

/* ── 分页 ─────────────────────────────────────────────────── */

.pagination {
  margin-top: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
}

.page-btn {
  padding: 6px 16px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background-color: #ffffff;
  font-size: 13px;
  font-weight: 500;
  line-height: 20px;
  color: #45556c;
}

.page-btn-disabled {
  color: #cbd5e1;
}

.page-info {
  font-size: 13px;
  line-height: 20px;
  color: #62748e;
}
