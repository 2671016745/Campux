/* 注册页：品牌区/卡片/输入框/页脚复用登录页那套实测样式，仅补注册视图特有部分。 */
@import "../login/login.wxss";

/* ── 标题区：标题 + 说明 + 右侧「返回登录」 ── */
.reg-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.reg-head-text {
  flex: 1;
  min-width: 0;
}

/* 卡片内标题与表单间距由 .reg-form 的 margin-top 控制，这里去掉说明文字自身的下边距 */
.reg-head-text .login-sub {
  margin-bottom: 0;
}

.reg-back {
  flex-shrink: 0;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #1447e6;
}

/* ── 表单：对应 form.mt-4.grid.gap-3 ── */
.reg-form {
  margin-top: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.reg-form .login-input {
  margin-top: 0;
}

/* 验证码行：grid-cols-[minmax(0,1fr)_auto] gap-2 */
.reg-code-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.reg-code-input {
  flex: 1;
  min-width: 0;
}

.reg-code-btn {
  flex-shrink: 0;
  height: 32px;
  padding: 0 12px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background-color: #ffffff;
  color: #1447e6;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
}

.reg-code-btn-off {
  color: #94a3b8;
}

/* 提示行：对应 p.text-sm.font-medium.text-slate-600 */
.reg-message {
  display: block;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  color: #45556c;
}

/* ── 提交按钮（小程序端两个） ── */
.reg-submit {
  margin-top: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.reg-btn-main {
  width: 100%;
  height: 32px;
  margin-top: 0;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  box-sizing: border-box;
}

.reg-bindbtn {
  width: 100%;
  height: 32px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background-color: #ffffff;
  color: #15803d;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
}

.reg-wxicon {
  width: 18px;
  height: 18px;
}

/* 原版禁用态是 opacity-50 的蓝按钮，不是置灰 */
.reg-btn-off {
  opacity: 0.5;
}

.reg-bindbtn-off {
  opacity: 0.5;
}
