/* 「稿件」页 —— 数值取自网页端 /posts（你的稿件）卡片的实测计算样式 */
.screen {
  padding: 16px 16px 96px;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.list-title {
  font-size: 16px;
  font-weight: 600;
  line-height: 24px;
  color: #020618;
}

.list-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.list-refresh {
  gap: 6px;
}

.list-refresh-icon {
  width: 14px;
  height: 14px;
}

/* 「我的稿件 / 待审核」分段控件（仅审核员及以上可见） */
.seg {
  display: flex;
  gap: 2px;
  margin-top: 12px;
  padding: 3px;
  background-color: #f1f5f9;
  border-radius: 10px;
}

.seg-item {
  flex: 1;
  height: 30px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 500;
  line-height: 18px;
  color: #62748e;
}

.seg-item-active {
  background-color: #ffffff;
  color: #0f172b;
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(15, 23, 43, 0.08);
}

.search-box {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 12px;
  padding: 0 12px;
  height: 36px;
  background-color: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
}

.search-icon {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  color: #0f172b;
}

.search-placeholder {
  color: #94a3b8;
}

.list-empty {
  padding: 32px 0;
  text-align: center;
}

/* 未登录占位里的「去登录」按钮：居中，宽度跟随内容 */
.loggedout-btn {
  display: flex;
  justify-content: center;
}

/* 卡片：白底 + 1px 描边 + 8px 圆角 + 内距 10px（实测 grid gap-2 p-2.5） */
.postcard {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 12px;
  padding: 10px;
  background-color: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
}

.postcard-top {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.postcard-main {
  min-width: 0;
}

.postcard-tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}

.tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.tag-icon {
  width: 12px;
  height: 12px;
  flex-shrink: 0;
}

/* 编号 / 附件数：白底 + 1px #e2e8f0 + 999px 圆角，11px/600 #314158 */
.tag-plain {
  padding: 2px 6px;
  background-color: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 999px;
  color: #314158;
  font-size: 11px;
  font-weight: 600;
  line-height: 16px;
}

/* 匿名展示：amber-50 底 + amber-200 边 + #973c00 字（实测） */
.tag-anon {
  padding: 2px 6px;
  background-color: #fffbeb;
  border: 1px solid #fee685;
  border-radius: 999px;
  color: #973c00;
  font-size: 11px;
  font-weight: 900;
  line-height: 16px;
}

/* 实名展示：sky 系（实测 bg #f0f9ff / 边 #b8e6fe / 字 #00598a） */
.tag-real {
  padding: 2px 6px;
  background-color: #f0f9ff;
  border: 1px solid #b8e6fe;
  border-radius: 999px;
  color: #00598a;
  font-size: 11px;
  font-weight: 900;
  line-height: 16px;
}

/* 投稿渠道：sky-100 底 + #0069a8 字，8px 圆角，12px/600 */
.tag-channel {
  padding: 2px 6px;
  background-color: #dff2fe;
  border-radius: 8px;
  color: #0069a8;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
}

/* 审核模式：投稿人（与网页端 postcard 里的作者标签同形态） */
.tag-author {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 2px 6px;
  background-color: #f1f5f9;
  border-radius: 8px;
  color: #45556c;
  font-size: 12px;
  font-weight: 600;
  line-height: 16px;
}

.tag-author-qq {
  font-weight: 400;
  color: #62748e;
}

/* 标题行：14px/600 + 截断（实测 h3 line-clamp-1 text-sm font-semibold text-slate-950） */
.postcard-title {
  margin-top: 6px;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #020618;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.postcard-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px;
}

/* 操作按钮：白/极浅底 + 1px #d8dbdf + 8px 圆角，12px/700 */
.action-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 28px;
  padding: 0 8px 0 6px;
  background-color: #f9fafb;
  border: 1px solid #d8dbdf;
  border-radius: 8px;
  color: #13181e;
  font-size: 12px;
  font-weight: 700;
  line-height: 16px;
}

.action-danger {
  height: 32px;
  color: #c10007;
}

/* 审核通过：绿色（与「已通过」状态同色系） */
.action-ok {
  height: 32px;
  color: #007a55;
  font-weight: 600;
}

.action-icon {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
}

/* 状态徽章：待审核为琥珀（实测 bg #fef3c6 / 环 #ffd230 / 字 #7a3306），12px/700 */
.tag-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 20px;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
  line-height: 16px;
}

.tag-status-pending {
  background-color: #fef3c6;
  border: 1px solid #ffd230;
  color: #7a3306;
}

.tag-status-active {
  background-color: #dcfce7;
  border: 1px solid #bbf7d0;
  color: #15803d;
}

.tag-status-neutral {
  background-color: #e5e8ec;
  color: #22272e;
}

/* 内容块：极浅灰底 + 1px #f1f5f9 + 8px 圆角 + 内距 8px 10px（实测） */
.postcard-body {
  padding: 8px 10px;
  background-color: rgba(248, 249, 252, 0.7);
  border: 1px solid #f1f5f9;
  border-radius: 8px;
}

.postcard-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin-bottom: 4px;
  font-size: 11px;
  font-weight: 600;
  line-height: 16px;
  color: #62748e;
}

.meta-item {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}

.meta-icon {
  width: 12px;
  height: 12px;
  flex-shrink: 0;
}

.postcard-text {
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  color: #13181e;
  word-break: break-word;
}

.postcard-images {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: 8px;
}

.postcard-image {
  width: 70px;
  height: 70px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  background-color: #f1f5f9;
}

.pager {
  margin-top: 16px;
  text-align: center;
}

.pager-info {
  font-size: 12px;
  font-weight: 700;
  line-height: 16px;
  color: #62748e;
}

.pager-buttons {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 8px;
}

.pager-btn {
  padding: 6px 12px;
  background-color: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 600;
  color: #314158;
}

.pager-btn-disabled {
  color: #94a3b8;
  background-color: #f9fafb;
}
