<view class="page">
  <view class="banner">{{bannerText}}</view>

  <view class="post-card" wx:if="{{!loggedIn}}">
    <view class="post-text">请先在「投稿」页完成微信登录</view>
    <button class="submit-btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="post-card">
      <view class="field-label">投稿内容</view>
      <textarea
        class="post-textarea"
        placeholder="在这里写下你想发布的内容…"
        value="{{text}}"
        maxlength="{{2000}}"
        bindinput="onTextareaInput"
      ></textarea>

      <view class="thumb-row" wx:if="{{imageUrls.length > 0}}">
        <view class="thumb-wrap" wx:for="{{imageUrls}}" wx:for-item="img" wx:key="*this">
          <image class="thumb" src="{{img}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage"></image>
          <view class="thumb-remove" data-index="{{index}}" catchtap="removeImage">×</view>
        </view>
      </view>

      <view class="choose-btn" bindtap="chooseImage">＋ 添加图片（最多 3 张）</view>

      <view class="tag-row">
        <view class="toggle {{showAnonymous ? 'toggle-anonymous-on' : ''}}" bindtap="toggleAnonymous">
          匿名投稿{{showAnonymous ? '（已开）' : ''}}
        </view>
        <view class="toggle {{showRules ? 'toggle-rules-on' : ''}}" bindtap="toggleRules">
          附投稿规则{{showRules ? '（已开）' : ''}}
        </view>
      </view>

      <button class="submit-btn" bindtap="submitPost" loading="{{submitting}}">发布</button>

      <view class="rules-text" wx:if="{{showRules}}">{{rulesText}}</view>
    </view>

    <view class="post-card" wx:if="{{lastResult}}">
      <view class="field-label">上次提交结果</view>
      <view class="post-text">{{lastResult}}</view>
    </view>
  </block>
</view>
