<app-header tenant-name="{{tenantName}}" logo-url="{{logoUrl}}" role-label="{{roleLabel}}"></app-header>

<view class="screen" wx:if="{{!loggedOut}}">
  <view class="list-head">
    <view class="list-title">{{mode === 'review' ? '待审核' : '你的稿件'}}</view>
    <view class="list-actions">
      <view class="pill list-refresh" bindtap="refresh">
        <view class="list-refresh-icon icon" style="background-image: url('{{icons.refresh.gray}}')"></view>
        <text>刷新</text>
      </view>
    </view>
  </view>

  <!-- 审核员及以上：我的稿件 / 待审核 两个视图 -->
  <view class="seg" wx:if="{{canReview}}">
    <view class="seg-item {{mode === 'mine' ? 'seg-item-active' : ''}}" data-mode="mine" bindtap="switchMode">
      <text>我的稿件</text>
    </view>
    <view class="seg-item {{mode === 'review' ? 'seg-item-active' : ''}}" data-mode="review" bindtap="switchMode">
      <text>待审核</text>
    </view>
  </view>

  <view class="search-box" wx:if="{{mode === 'mine'}}">
    <view class="search-icon icon" style="background-image: url('{{icons.search.gray}}')"></view>
    <input
      class="search-input"
      placeholder="搜索稿件内容或编号"
      placeholder-class="search-placeholder"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
      bindconfirm="refresh"
    />
  </view>

  <view class="list-empty" wx:if="{{!posts.length}}">
    <text class="muted">{{loading ? '正在加载…' : (mode === 'review' ? '暂时没有待审核稿件。' : '还没有稿件，去「投稿」写一条吧。')}}</text>
  </view>

  <!-- 卡片结构与网页端一致：标签行(编号/展示/渠道/附件) + 标题 + 操作区(预览图/取消/状态) + 浅灰内容块(元信息+正文) -->
  <view class="postcard" wx:for="{{posts}}" wx:key="id">
    <view class="postcard-top">
      <view class="postcard-main">
        <view class="postcard-tags">
          <view class="tag tag-plain">
            <view class="tag-icon icon" style="background-image: url('{{icons.hash.slate700}}')"></view>
            <text>{{item.displayId}}</text>
          </view>
          <view class="tag {{item.anonymous ? 'tag-anon' : 'tag-real'}}">
            <view
              class="tag-icon icon"
              style="background-image: url('{{item.anonymous ? icons.eye.amberDark : icons.eye.sky}}')"
            ></view>
            <text>{{item.anonymous ? '匿名展示' : '实名展示'}}</text>
          </view>
          <view class="tag tag-channel" wx:if="{{item.channelLabel}}">
            <text>{{item.channelLabel}}</text>
          </view>
          <view class="tag tag-plain" wx:if="{{item.attachmentCount > 0}}">
            <view class="tag-icon icon" style="background-image: url('{{icons.paperclip.slate700}}')"></view>
            <text>{{item.attachmentCount}} 个附件</text>
          </view>
          <!-- 审核模式下要看清是谁投的 -->
          <view class="tag tag-author" wx:if="{{mode === 'review' && item.author}}">
            <text>{{item.author}}</text>
            <text class="tag-author-qq" wx:if="{{item.authorQq}}">QQ {{item.authorQq}}</text>
          </view>
        </view>
        <view class="postcard-title">{{item.title}}</view>
      </view>

      <view class="postcard-actions">
        <view class="action-btn" data-id="{{item.id}}" bindtap="previewPost">
          <view class="action-icon icon" style="background-image: url('{{icons.image.slate700}}')"></view>
          <text>预览图</text>
        </view>
        <view class="action-btn action-danger" wx:if="{{item.cancellable}}" data-id="{{item.id}}" bindtap="cancelPost">
          <view class="action-icon icon" style="background-image: url('{{icons.xCircle.red}}')"></view>
          <text>取消</text>
        </view>
        <!-- 审核模式：通过 / 拒绝 -->
        <view class="action-btn action-ok" wx:if="{{mode === 'review'}}" data-id="{{item.id}}" bindtap="approveReview">
          <text>{{reviewBusyId === item.id ? '处理中…' : '通过'}}</text>
        </view>
        <view class="action-btn action-danger" wx:if="{{mode === 'review'}}" data-id="{{item.id}}" bindtap="rejectReview">
          <text>拒绝</text>
        </view>
        <view class="tag-status tag-status-{{item.statusTone}}">
          <text>{{item.statusLabel}}</text>
        </view>
      </view>
    </view>

    <view class="postcard-body">
      <view class="postcard-meta">
        <view class="meta-item">
          <view class="meta-icon icon" style="background-image: url('{{icons.textIcon.gray}}')"></view>
          <text>{{item.textLength}} 字</text>
        </view>
        <view class="meta-item">
          <view class="meta-icon icon" style="background-image: url('{{icons.clock.gray}}')"></view>
          <text>{{item.createdAt}}</text>
        </view>
      </view>
      <view class="postcard-text">{{item.text}}</view>
      <view class="postcard-images" wx:if="{{item.imageUrls.length > 0}}">
        <image
          class="postcard-image"
          wx:for="{{item.imageUrls}}"
          wx:for-item="img"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          data-urls="{{item.imageUrls}}"
          data-index="{{index}}"
          bindtap="previewImage"
        ></image>
      </view>
    </view>
  </view>

  <view class="pager" wx:if="{{pageCount > 1}}">
    <text class="pager-info">第 {{page}} / {{pageCount}} 页，共 {{total}} 条</text>
    <view class="pager-buttons">
      <view class="pager-btn {{page <= 1 ? 'pager-btn-disabled' : ''}}" bindtap="prevPage">上一页</view>
      <view class="pager-btn {{page >= pageCount ? 'pager-btn-disabled' : ''}}" bindtap="nextPage">下一页</view>
    </view>
  </view>
</view>

<!-- 未登录（或 token 已失效）：不硬跳登录页，留在本页给一个入口 -->
<view class="screen" wx:else>
  <view class="list-empty">
    <text class="muted">登录后才能查看自己的稿件。</text>
  </view>
  <view class="loggedout-btn">
    <view class="postbtn" bindtap="goLogin"><text>去登录</text></view>
  </view>
</view>
