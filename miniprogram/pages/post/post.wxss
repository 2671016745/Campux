/* 「投稿」页 —— 数值取自网页端 /post 的实测计算样式 */
.screen {
  padding: 16px 16px 96px;
}

.compose {
  padding: 16px;
}

.compose-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #f1f5f9;
}

.compose-head-text {
  min-width: 0;
}

.compose-title {
  font-size: 16px;
  font-weight: 600;
  line-height: 24px;
  color: #020618;
}

.compose-sub {
  margin-top: 4px;
  font-size: 14px;
  line-height: 20px;
  color: #62748e;
}

/* 无边框、白底、16px/28px —— 与网页端 Textarea 一致 */
.compose-textarea {
  width: 100%;
  min-height: 144px;
  padding: 4px 0;
  box-sizing: border-box;
  background-color: #ffffff;
  border: none;
  font-size: 16px;
  line-height: 28px;
  color: #0f172b;
}

.compose-placeholder {
  color: #94a3b8;
}

.attach-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

/* 缩略图 70×70（网页端 h-[70px] w-[70px] rounded-md border-slate-200 bg-slate-100） */
.attach-thumb {
  position: relative;
  width: 70px;
  height: 70px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  background-color: #f1f5f9;
  overflow: hidden;
}

.attach-img {
  width: 100%;
  height: 100%;
}

/* 添加按钮 64×64 虚线（网页端 h-16 w-16 border-dashed border-slate-300） */
.attach-add {
  width: 64px;
  height: 64px;
  border: 1px dashed #cad5e2;
  border-radius: 8px;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.attach-add-icon {
  width: 28px;
  height: 28px;
}

.attach-hint {
  margin-top: 8px;
  font-size: 12px;
  line-height: 20px;
  color: #62748e;
}

.anon-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  padding: 8px 12px;
}

.anon-text {
  flex: 1;
  min-width: 0;
}

.anon-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #15803d;
}

.anon-sub {
  font-size: 12px;
  font-weight: 400;
  line-height: 20px;
  color: #15803d;
  opacity: 0.8;
}

.anon-switch {
  flex-shrink: 0;
  transform: scale(0.9);
}

.rules-line {
  margin-top: 12px;
  font-size: 14px;
  line-height: 20px;
}

.rules-prefix {
  color: #62748e;
}

.rules-link {
  margin-left: 4px;
  font-weight: 500;
  color: #b45309;
  text-decoration: underline;
}

.submit-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
}

.status-block {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  padding: 12px;
}

.status-text {
  min-width: 0;
}

.status-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #0f172b;
}

.status-sub {
  margin-top: 4px;
  font-size: 14px;
  line-height: 20px;
  color: #62748e;
}

.status-limit {
  margin-top: 4px;
  font-size: 12px;
  line-height: 16px;
  color: #62748e;
}
