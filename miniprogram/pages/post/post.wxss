/* 「投稿」页 —— 数值取自网页端 /post 的实测计算样式 */
.screen {
  padding: 16px 16px calc(96px + env(safe-area-inset-bottom));
}

.compose {
  padding: 16px;
}

.compose-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #f1f5f9;
}

.compose-head-text {
  min-width: 0;
}

.compose-title {
  font-size: 16px;
  font-weight: 600;
  line-height: 24px;
  color: #020618;
}

.compose-sub {
  margin-top: 4px;
  font-size: 14px;
  line-height: 20px;
  color: #62748e;
}

/* 无边框、白底、16px/28px —— 与网页端 Textarea 一致（实测 font-size:16px / line-height:28px /
   min-height:144px / padding:4px 0） */
.compose-textarea {
  width: 100%;
  min-height: 144px;
  padding: 4px 0;
  box-sizing: border-box;
  background-color: #ffffff;
  border: none;
  font-size: 16px;
  line-height: 28px;
  color: #0f172b;
}

/* 未输入时把行高压回字号：小程序原生 textarea 的光标是按行高画的，28px 行高会让空态的
   闪烁光标比 16px 的字高一截（网页浏览器不会，所以原版没这个问题）。
   一输入文字就切回 28px，正文行距与网页端完全一致；占位文字的行距由下面单独维持。 */
.compose-textarea.is-empty {
  line-height: 16px;
}

.compose-placeholder {
  color: #94a3b8;
  line-height: 28px;
}

/* 弹层打开时替 textarea 占位（尺寸与它一致，避免布局跳动） */
.compose-textarea-hold {
  display: block;
}

.attach-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 12px;
}

/* 缩略图 70×70（网页端 h-[70px] w-[70px] rounded-md border-slate-200 bg-slate-100） */
.attach-thumb {
  position: relative;
  width: 70px;
  height: 70px;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  background-color: #f1f5f9;
  overflow: hidden;
}

.attach-img {
  width: 100%;
  height: 100%;
}

/* 添加按钮 64×64 虚线（网页端 h-16 w-16 border-dashed border-slate-300） */
.attach-add {
  width: 64px;
  height: 64px;
  border: 1px dashed #cad5e2;
  border-radius: 8px;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.attach-add-icon {
  width: 28px;
  height: 28px;
}

.attach-hint {
  margin-top: 8px;
  font-size: 12px;
  line-height: 20px;
  color: #62748e;
}

.anon-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  padding: 8px 12px;
}

.anon-text {
  flex: 1;
  min-width: 0;
}

.anon-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #15803d;
}

.anon-sub {
  font-size: 12px;
  font-weight: 400;
  line-height: 20px;
  color: #15803d;
  opacity: 0.8;
}

.anon-switch {
  flex-shrink: 0;
  transform: scale(0.9);
}

.rules-line {
  margin-top: 12px;
  font-size: 14px;
  line-height: 20px;
}

.rules-prefix {
  color: #62748e;
}

.rules-link {
  margin-left: 4px;
  font-weight: 500;
  color: #b45309;
  text-decoration: underline;
}

.submit-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
}

.status-block {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  margin-top: 12px;
  padding: 12px;
}

.status-text {
  min-width: 0;
}

.status-title {
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #0f172b;
}

.status-sub {
  margin-top: 4px;
  font-size: 14px;
  line-height: 20px;
  color: #62748e;
}

.status-limit {
  margin-top: 4px;
  font-size: 12px;
  line-height: 16px;
  color: #62748e;
}

/* ── 登录后「绑定微信」引导弹窗 ─────────────────────────────────────── */
.bind-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 90;
  background-color: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.bind-sheet {
  width: 300px;
  padding: 20px 16px 12px;
  box-sizing: border-box;
  border-radius: 12px;
  background-color: #ffffff;
}

.bind-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  line-height: 22px;
  color: #020618;
  text-align: center;
}

.bind-desc {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  line-height: 20px;
  color: #62748e;
  text-align: center;
}

.bind-actions {
  margin-top: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.bind-btn {
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background-color: #ffffff;
  color: #45556c;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
}

.bind-btn-primary {
  border-color: #2563eb;
  background-color: #2563eb;
  color: #ffffff;
  font-weight: 600;
}

.bind-btn-muted {
  color: #94a3b8;
}

.bind-foot {
  margin-top: 12px;
  padding-top: 10px;
  border-top: 1px solid #f1f5f9;
  font-size: 12px;
  line-height: 16px;
  color: #94a3b8;
  text-align: center;
}
