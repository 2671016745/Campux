/* 「待发布队列」—— 沿用 admin/services 的信息面 + 卡片语言 */

.section-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text-950);
  margin: 0 0 6px;
}

.section-sub {
  font-size: 12px;
  line-height: 20px;
  color: var(--muted);
  margin: 0 0 12px;
}

.mode-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 12px;
  margin-bottom: 12px;
  background: var(--blue-bg);
  border: 1px solid var(--blue-border);
  border-radius: var(--radius);
}

.mode-text {
  font-size: 12px;
  color: var(--blue-text);
  font-weight: 600;
}

.mode-btn {
  flex-shrink: 0;
  padding: 5px 10px;
  border-radius: 999px;
  background: #fff;
  border: 1px solid var(--blue-border);
  color: var(--blue-text);
  font-size: 12px;
  font-weight: 600;
}

.mode-btn-off {
  opacity: .5;
}

.batch-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
}

.batch-info {
  font-size: 12px;
  color: var(--muted);
}

.batch-btn {
  padding: 7px 14px;
  border-radius: var(--radius);
  background: var(--primary);
  color: #fff;
  font-size: 13px;
  font-weight: 700;
}

.batch-btn-off {
  background: var(--disabled);
}

.empty {
  padding: 40px 0;
  text-align: center;
}

.pub-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 10px;
}

.pub-head {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.pub-check {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  border: 1px solid #cbd5e1;
  border-radius: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  color: #fff;
  background: #fff;
}

.pub-check-on {
  background: var(--primary);
  border-color: var(--primary);
}

.pub-title {
  display: flex;
  align-items: center;
  gap: 6px;
  flex: 1;
  min-width: 0;
}

.pub-author {
  font-size: 12px;
  color: var(--muted-700);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pub-anon {
  font-size: 11px;
  padding: 1px 6px;
  border-radius: 999px;
  background: var(--slate-pill-bg);
  color: var(--slate-pill-text);
}

.pub-time {
  font-size: 11px;
  flex-shrink: 0;
}

.pub-text {
  font-size: 14px;
  line-height: 22px;
  color: var(--text);
  margin-bottom: 10px;
  word-break: break-word;
}

.pub-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pub-btn {
  padding: 6px 12px;
  border-radius: var(--radius);
  background: #ecfdf5;
  border: 1px solid #bbf7d0;
  color: #15803d;
  font-size: 12px;
  font-weight: 700;
}

.pub-btn-off {
  opacity: .5;
}

.pager {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 16px 0;
}

.pager-btn {
  padding: 6px 14px;
  border-radius: var(--radius);
  border: 1px solid var(--border);
  background: #fff;
  font-size: 12px;
  color: var(--text-900);
}

.pager-off {
  opacity: .4;
}

.pager-info {
  font-size: 12px;
}

.btn-row {
  display: flex;
  gap: 8px;
  margin-top: 16px;
}

.btn-wide {
  flex: 1;
}
