<!--
  强制改密页 —— 结构对应 apps/web/src/features/auth/RequiredPasswordChangeScreen.tsx：
    品牌区      ← 复用登录页 .login-brand
    卡片        ← form.product-surface.px-4.py-5
    标题 + 说明 ← p.text-lg.font-semibold + p.mt-2.text-sm
    表单        ← 新密码 / 确认新密码 + 提示行 + 「保存并继续」+ 「退出登录」
    页脚        ← div.mt-5.border-t.border-slate-100.pt-3.text-center
  表单样式复用登录页实测样式（login.wxss），不另立视觉体系。
-->
<view class="login-page">
  <view class="login-brand">
    <view class="login-brand-box">
      <image class="login-brand-img" src="{{logoUrl || '/assets/logo.png'}}" mode="aspectFit" />
    </view>
    <text class="login-brand-name">Campux</text>
  </view>

  <view class="surface login-card">
    <!-- 误进本页（未标记必须改密）：给一句说明 + 回首页 -->
    <block wx:if="{{blocked}}">
      <text class="login-title">无法修改密码</text>
      <text class="login-sub">当前账号不需要修改密码。</text>
      <view class="postbtn reg-btn-main" bindtap="goHome">
        <text>返回首页</text>
      </view>
    </block>

    <block wx:else>
      <text class="login-title">请先设置新密码</text>
      <text class="login-sub">你的账号通过校园墙机器人注册，初始密码是随机密码。首次登录后需要换成你自己的密码。</text>

      <view class="reg-form">
        <input
          class="login-input"
          password
          placeholder="新密码，至少 6 位"
          placeholder-class="login-placeholder"
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
        />
        <input
          class="login-input"
          password
          placeholder="再次输入新密码"
          placeholder-class="login-placeholder"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
        />
        <text class="reg-message {{message ? 'reg-message-error' : ''}}" wx:if="{{message}}">{{message}}</text>
        <view
          class="postbtn reg-btn-main {{busy || !canSubmit ? 'reg-btn-off' : ''}}"
          bindtap="onSubmit"
        >
          <text>{{busy ? '保存中' : '保存并继续'}}</text>
        </view>
        <view class="reg-logout" bindtap="onLogout">
          <text>退出登录</text>
        </view>
      </view>
    </block>

    <view class="login-card-footer">
      <text class="login-card-footer-text">由 Campux 提供技术支持</text>
    </view>
  </view>
</view>
