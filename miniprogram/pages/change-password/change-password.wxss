/*
 * 强制改密页样式 —— 品牌区/卡片/输入框/页脚全部复用登录页实测样式（login.wxss），
 * 只补本页特有的：表单纵向排布、提示行、主按钮与「退出登录」。
 */
@import "../login/login.wxss";

/* ── 表单：对应网页端 form 里的 grid.gap-3 ── */
.reg-form {
  margin-top: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.reg-form .login-input {
  margin-top: 0;
}

/* 提示行：失败为红，其余为 slate（网页端同一行按错误/信息切换颜色） */
.reg-message {
  display: block;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  color: #45556c;
}

.reg-message-error {
  color: #dc2626;
}

/* 主按钮：与登录页 login-btn 同尺寸，禁用态沿用注册页的 opacity-50 蓝按钮风格 */
.reg-btn-main {
  width: 100%;
  height: 32px;
  margin-top: 0;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  box-sizing: border-box;
}

.reg-btn-off {
  opacity: 0.5;
}

/* 退出登录：对应网页端 Button variant="ghost" */
.reg-logout {
  text-align: center;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  color: #45556c;
}
