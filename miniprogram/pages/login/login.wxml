<view class="login-page">
  <!-- 品牌区：对应 app.campux.top 的 section>div.mb-5（52×52 方块 r18 + Campux 20px/600） -->
  <view class="login-brand">
    <view class="login-brand-box">
      <image class="login-brand-img" src="{{logoUrl || '/assets/logo.png'}}" mode="aspectFit" />
    </view>
    <text class="login-brand-name">Campux</text>
  </view>

  <!-- 登录卡片：对应 form.product-surface.px-4.py-5 -->
  <view class="surface login-card">
    <text class="login-title">登录到 Campux</text>
    <text class="login-sub">输入 QQ 号或邮箱，以及你的账号密码。</text>

    <input
      class="login-input"
      placeholder="QQ 号 / 邮箱"
      placeholder-class="login-placeholder"
      value="{{account}}"
      bindinput="onAccountInput"
    />
    <input
      class="login-input"
      password
      placeholder="密码"
      placeholder-class="login-placeholder"
      value="{{password}}"
      bindinput="onPasswordInput"
    />

    <view class="postbtn login-btn {{loginBusy || !account || !password ? 'postbtn-disabled' : ''}}" bindtap="onPasswordLogin">
      <text>{{loginBusy ? '登录中…' : (unbound ? '登录并绑定微信' : '登录')}}</text>
    </view>

    <view class="login-tip" wx:if="{{unbound}}">
      该微信还没绑定校园墙账号：填好上面的账号密码，点「登录并绑定微信」即可同时完成登录和绑定。
    </view>
  </view>

  <!-- 微信快捷登录区块 -->
  <view class="surface login-extra">
    <text class="login-extra-title">还没有绑定微信？</text>
    <text class="login-extra-desc">微信快捷登录需要先自行登录后绑定：用上面的账号密码登录，在「服务」页绑定微信，之后即可一键登录。</text>
    <view class="login-wxbtn {{loggingIn ? 'login-wxbtn-disabled' : ''}}" bindtap="onWechatLogin">
      <image class="login-wxicon" src="/assets/wechat.png" mode="aspectFit" />
      <text>{{loggingIn ? '登录中…' : '微信快捷登录'}}</text>
    </view>
  </view>

  <!-- 注册区块：对应原版「墙号运营者第一次使用？」 -->
  <view class="surface login-extra">
    <text class="login-extra-title">第一次使用？</text>
    <text class="login-extra-desc">注册运营管理员账号即可自助创建校园墙。普通用户请通过对应校园墙机器人注册，已有账号可直接登录。</text>
    <view class="login-regbtn" bindtap="goRegister">注册</view>
  </view>

  <text class="login-footer">由 Campux 提供技术支持</text>
</view>
