<!--
  忘记密码页 —— 结构对应 apps/web/src/features/auth/LoginScreen.tsx 的 ForgotPasswordPanel：
    标题区 ← div.flex.items-start.justify-between.gap-3（标题 + 说明 + 右侧「返回登录」）
    第一步  邮箱输入 + 「发送验证码」（对应网页端的 account + 发送按钮，60s 冷却）
    第二步  验证码 + 新密码 + 「重置密码」（对应网页端的 code + newPassword 提交）
    提示行  ← p.text-sm.font-medium（失败为红，成功/信息为 slate）
    页脚    ← div.mt-5.border-t.border-slate-100.pt-3.text-center
  表单样式复用登录页实测样式（login.wxss），不另立视觉体系。
-->
<view class="login-page">
  <view class="login-brand">
    <view class="login-brand-box">
      <image class="login-brand-img" src="{{logoUrl || '/assets/logo.png'}}" mode="aspectFit" />
    </view>
    <text class="login-brand-name">Campux</text>
  </view>

  <view class="surface login-card">
    <view class="reg-head">
      <view class="reg-head-text">
        <text class="login-title">重置密码</text>
        <text class="login-sub">输入你的 QQ 号或邮箱，我们会把验证码发到账号绑定的邮箱；验证通过后即可设置新密码。没绑定邮箱的账号请联系校园墙管理员。</text>
      </view>
      <view class="reg-back" bindtap="goLogin">
        <text>返回登录</text>
      </view>
    </view>

    <!-- 第一步：发送验证码（发送成功后进入第二步，与服务端 60s 冷却一致） -->
    <view class="reg-form" wx:if="{{step === 1}}">
      <input
        class="login-input"
        placeholder="QQ 号 / 邮箱"
        placeholder-class="login-placeholder"
        value="{{email}}"
        bindinput="onEmailInput"
      />
      <text class="reg-message" wx:if="{{message}}">{{message}}</text>
      <view
        class="postbtn reg-btn-main {{sending || countdown > 0 || !email ? 'reg-btn-off' : ''}}"
        bindtap="sendCode"
      >
        <text>{{sending ? '发送中' : (countdown > 0 ? countdown + 's 后重发' : '发送验证码')}}</text>
      </view>
    </view>

    <!-- 第二步：输入验证码 + 新密码，提交重置 -->
    <view class="reg-form" wx:if="{{step === 2}}">
      <text class="reg-sent">验证码已发送到 {{email}}，10 分钟内有效。</text>
      <input
        class="login-input"
        type="number"
        maxlength="6"
        placeholder="6 位验证码"
        placeholder-class="login-placeholder"
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <input
        class="login-input"
        password
        placeholder="新密码，至少 6 位"
        placeholder-class="login-placeholder"
        value="{{newPassword}}"
        bindinput="onPasswordInput"
      />
      <text class="reg-message" wx:if="{{message}}">{{message}}</text>
      <view
        class="postbtn reg-btn-main {{busy || !canSubmit ? 'reg-btn-off' : ''}}"
        bindtap="onReset"
      >
        <text>{{busy ? '重置中' : '重置密码'}}</text>
      </view>
    </view>

    <view class="login-card-footer">
      <text class="login-card-footer-text">由 Campux 提供技术支持</text>
    </view>
  </view>
</view>
