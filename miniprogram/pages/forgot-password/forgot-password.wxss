/*
 * 忘记密码页样式 —— 品牌区/卡片/输入框/页脚全部复用登录页实测样式（login.wxss），
 * 只补本页特有的：标题区右侧「返回登录」、发送成功提示行、按钮禁用态。
 */
@import "../login/login.wxss";

/* ── 标题区：与注册页同一模式（标题 + 说明 + 右侧返回登录） ── */
.reg-back {
  flex-shrink: 0;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #1447e6;
}

/* ── 表单：对应网页端 form.mt-4.grid.gap-3 ── */
.reg-form {
  margin-top: 16px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.reg-form .login-input {
  margin-top: 0;
}

/* 发送成功后的邮箱提示行：对应 p.text-sm.font-medium.text-slate-600 */
.reg-sent {
  display: block;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  color: #45556c;
  word-break: break-all;
}

/* 提示行：失败为红，其余为 slate（网页端同一行按 messageKind 切换颜色） */
.reg-message {
  display: block;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  color: #45556c;
}

.reg-message-error {
  color: #dc2626;
}

/* 主按钮：与登录页 login-btn 同尺寸，禁用态沿用注册页的 opacity-50 蓝按钮风格 */
.reg-btn-main {
  width: 100%;
  height: 32px;
  margin-top: 0;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  box-sizing: border-box;
}

.reg-btn-off {
  opacity: 0.5;
}
