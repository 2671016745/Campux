.page {
  padding: 12px;
  background-color: #fafafa;
  min-height: 100vh;
  box-sizing: border-box;
}

.login-title {
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 6px;
}

.login-hint {
  font-size: 12px;
  color: #666;
  margin-bottom: 12px;
  line-height: 1.6;
}

.bind-form {
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px dashed #ddd;
}

.bind-tip {
  font-size: 12px;
  color: #d97706;
  margin-bottom: 8px;
  line-height: 1.6;
}

.input {
  border: 1px solid #ddd;
  border-radius: 4px;
  padding: 8px 10px;
  margin-bottom: 8px;
  background-color: #fff;
  font-size: 14px;
}

.user-card {
  display: flex;
  align-items: center;
}

/* 墙没有 logo 时的占位头像（首字母），避免 <image src=""> 出现裂图 */
.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #e6e6e6;
  color: #666;
  font-size: 14px;
  font-weight: 600;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 15px;
  font-weight: 600;
}

.user-sub {
  font-size: 12px;
  color: #666;
  margin-top: 2px;
}

.logout {
  font-size: 12px;
  color: #e91e63;
  padding: 4px 8px;
}

.post-id {
  color: #999;
  margin-right: 6px;
}

.post-foot {
  margin-top: 8px;
  display: flex;
  align-items: center;
}

.status-tag {
  display: inline-block;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 12px;
  background-color: #f0f0f0;
  color: #555;
  margin-left: 6px;
}
