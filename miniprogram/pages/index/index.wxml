<view class="page">
  <view class="banner">{{bannerText}}</view>

  <!-- 未登录：微信一键登录 / 首次绑定 -->
  <view class="post-card" wx:if="{{!loggedIn}}">
    <view class="login-title">登录 Campux</view>
    <view class="login-hint">微信一键登录；首次登录需绑定你已有的校园墙账号</view>
    <button class="submit-btn" bindtap="onWechatLogin" loading="{{loggingIn}}">微信一键登录</button>

    <view class="bind-form" wx:if="{{unbound}}">
      <view class="bind-tip">该微信尚未绑定账号，请用你的 QQ 号或 QQ 邮箱登录一次以完成绑定</view>
      <input class="input" placeholder="QQ 号或 QQ 邮箱" value="{{account}}" bindinput="onAccountInput" />
      <input class="input" placeholder="密码" password="{{true}}" value="{{password}}" bindinput="onPasswordInput" />
      <button class="submit-btn" bindtap="onBind" loading="{{binding}}">绑定并登录</button>
    </view>
  </view>

  <!-- 已登录：身份卡 + 我的稿件 -->
  <block wx:else>
    <view class="post-card user-card">
      <image class="post-avatar" src="{{tenantLogo}}" mode="aspectFill"></image>
      <view class="user-info">
        <view class="user-name">{{userName}}</view>
        <view class="user-sub">{{tenantName}} · {{roleLabel}}</view>
      </view>
      <view class="logout" bindtap="onLogout">退出</view>
    </view>

    <view class="post-card" wx:if="{{!posts.length}}">
      <view class="post-text">{{loadingPosts ? '加载中…' : '暂无稿件'}}</view>
    </view>

    <view class="post-card" wx:for="{{posts}}" wx:key="id">
      <view class="post-text">
        <text class="post-id">#{{item.displayId}}</text>
        <text>{{item.text}}</text>
      </view>
      <view class="post-images" wx:if="{{item.imageUrls.length > 0}}">
        <image
          class="post-image"
          wx:for="{{item.imageUrls}}"
          wx:for-item="img"
          wx:key="*this"
          src="{{img}}"
          mode="aspectFill"
          data-urls="{{item.imageUrls}}"
          data-index="{{index}}"
          bindtap="onPreviewImage"
        ></image>
      </view>
      <view class="post-foot">
        <text class="annonymous-tag" wx:if="{{item.anonymous}}">匿名</text>
        <text class="status-tag">{{item.statusLabel}}</text>
      </view>
    </view>
  </block>
</view>
