/* 用户管理页 —— 沿用 Campux 信息面 + 行式列表风格 */

/* ── 搜索区 ── */
.search-card {
  padding: 16px;
  box-sizing: border-box;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 36px;
  padding: 0 12px;
  box-sizing: border-box;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background-color: #ffffff;
  font-size: 14px;
  line-height: 20px;
  color: #13181e;
}

.search-placeholder {
  color: #94a3b8;
  font-size: 14px;
}

.search-btn {
  flex-shrink: 0;
  height: 36px;
  padding: 0 16px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 36px;
}

.search-clear {
  margin-top: 8px;
  text-align: right;
}

.search-clear-text {
  font-size: 12px;
  line-height: 16px;
  color: #1447e6;
}

/* ── 成员列表 ── */
.list-card {
  margin-top: 12px;
  padding: 16px;
  box-sizing: border-box;
}

.list-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
}

.page-title {
  font-size: 16px;
  font-weight: 600;
  line-height: 24px;
  color: #0f172b;
}

.list-total {
  font-size: 12px;
  line-height: 16px;
}

.member-list {
  display: flex;
  flex-direction: column;
}

.member-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  border-bottom: 1px solid #f1f5f9;
}

.member-item:last-child {
  border-bottom: none;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  display: block;
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
  color: #0f172b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-meta {
  display: block;
  margin-top: 2px;
  font-size: 12px;
  line-height: 16px;
}

.member-role {
  flex-shrink: 0;
}

.role-badge {
  display: inline-flex;
  align-items: center;
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  line-height: 16px;
}

.role-submitter {
  background-color: #f1f5f9;
  color: #45556c;
}

.role-reviewer {
  background-color: #eff6ff;
  color: #1d4ed8;
}

.role-admin {
  background-color: #f0fdf4;
  color: #15803d;
}

/* ── 空状态 ── */
.empty-state {
  padding: 32px 0;
  text-align: center;
}

/* ── 分页 ── */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid #f1f5f9;
}

.page-btn {
  padding: 6px 16px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background-color: #ffffff;
  font-size: 14px;
  line-height: 20px;
  color: #1447e6;
}

.page-btn-disabled {
  color: #94a3b8;
  background-color: #f8fafc;
}

.page-info {
  font-size: 14px;
  line-height: 20px;
}

/* ── 添加用户 ── */
.invite-card {
  margin-top: 12px;
  padding: 16px;
  box-sizing: border-box;
}

.invite-hint {
  display: block;
  margin-top: 4px;
  margin-bottom: 12px;
  font-size: 12px;
  line-height: 16px;
}

.invite-input {
  width: 100%;
  height: 36px;
  padding: 0 12px;
  box-sizing: border-box;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background-color: #ffffff;
  font-size: 14px;
  line-height: 20px;
  color: #13181e;
}

.invite-picker {
  margin-top: 12px;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 36px;
  padding: 0 12px;
  box-sizing: border-box;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background-color: #ffffff;
  font-size: 14px;
  line-height: 20px;
  color: #13181e;
}

.picker-arrow {
  color: #94a3b8;
  font-size: 12px;
}

.invite-btn {
  margin-top: 12px;
  width: 100%;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 36px;
  box-sizing: border-box;
}

/* ── 未登录占位 ── */
.login-placeholder {
  padding: 32px 16px;
  box-sizing: border-box;
  text-align: center;
}

.login-placeholder .muted {
  display: block;
  margin-top: 8px;
  font-size: 14px;
  line-height: 20px;
}

.login-btn {
  margin-top: 20px;
  width: 100%;
  height: 36px;
  border-radius: 8px;
  font-size: 14px;
  line-height: 36px;
  box-sizing: border-box;
}
