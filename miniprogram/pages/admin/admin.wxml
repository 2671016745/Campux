<view class="page">
  <view class="post-card" wx:if="{{!loggedIn}}">
    <view class="post-text">未登录，请先在「投稿」页微信登录</view>
  </view>

  <block wx:else>
    <view class="post-card">
      <view class="field-label">我的权限</view>
      <view class="row"><text class="k">校园墙</text><text class="v">{{tenantName}}</text></view>
      <view class="row"><text class="k">身份</text><text class="v">{{roleLabel}}</text></view>
      <view class="row"><text class="k">待审核</text><text class="v">{{pendingCount}} 条</text></view>
    </view>

    <view class="post-card" wx:if="{{canReview}}">
      <view class="field-label">审核入口</view>
      <view class="hint">当前小程序版本（v1）只覆盖投稿与登录；审核、发布目标、统计等管理功能请使用网页端。</view>
      <button class="submit-btn" bindtap="openWebConsole">打开网页管理端</button>
      <button class="ghost-btn" bindtap="copyConsoleUrl">复制管理端地址</button>
    </view>

    <view class="post-card" wx:else>
      <view class="hint">你的身份是「{{roleLabel}}」，没有审核权限。如需审核，请联系校园墙管理员在网页端授予。</view>
    </view>
  </block>
</view>
