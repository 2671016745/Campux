.page {
  padding: 12px;
  background-color: #fafafa;
  min-height: 100vh;
  box-sizing: border-box;
}

.field-label {
  font-size: 13px;
  color: #666;
  margin-bottom: 8px;
}

.row {
  display: flex;
  padding: 6px 0;
  font-size: 14px;
}

.k {
  width: 90px;
  color: #888;
}

.v {
  flex: 1;
  color: #333;
}

.hint {
  font-size: 12px;
  color: #888;
  line-height: 1.6;
  margin-bottom: 10px;
}

.ghost-btn {
  width: 100%;
  padding: 10px;
  background-color: #fff;
  color: #555;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 15px;
}
