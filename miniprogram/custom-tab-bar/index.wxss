/* 自定义 tabBar：数值取自 MobileTabBar.tsx 的实测计算样式 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  /* 64px 是设计高度，再加 iPhone 底部安全区，否则文字被 home indicator 压住 */
  height: calc(64px + env(safe-area-inset-bottom));
  width: 100%;
  box-sizing: border-box;
  padding: 6px 12px calc(8px + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 1px solid #e2e8f0;
}

.tabbar-grid {
  position: relative;
  display: flex;
  height: 52px;
  width: 100%;
}

.tabbar-item {
  position: relative;
  z-index: 10;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  height: 52px;
  font-size: 12px;
  font-weight: 500;
  line-height: 12px;
  color: #62748e;
}

.tabbar-item-active {
  color: #1447e6;
}

.tabbar-icon {
  width: 20px;
  height: 20px;
  /* 组件默认样式隔离，app.wxss 里的 .icon 不会进到组件内 —— 这里必须自己写全，
     否则 background-size 退回 auto，24×24 的 SVG 塞进 20×20 的框会被裁掉右下角。 */
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.tabbar-label {
  font-size: 12px;
  font-weight: 500;
  line-height: 12px;
  color: inherit;
}

.tabbar-indicator {
  position: absolute;
  bottom: 0;
  height: 3px;
  border-radius: 999px;
  background-color: #155dfc;
  transition: left 0.5s cubic-bezier(0.65, 0, 0.35, 1), width 0.5s cubic-bezier(0.65, 0, 0.35, 1);
}
