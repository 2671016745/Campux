/* Header 组件自带样式（组件默认样式隔离，故不依赖 app.wxss） */
.appheader {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 57px; /* 网页端实测 375x57：h-14(56) + 1px 底边框 */
  padding: 0 16px;
  background-color: #ffffff;
  border-bottom: 1px solid #e2e8f0;
  box-sizing: border-box;
}

.appheader-left {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.appheader-logo {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  background-color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  font-size: 15px;
  font-weight: 700;
  color: #62748e;
  box-sizing: border-box;
}

.appheader-wordmark {
  font-size: 18px;
  font-weight: 700;
  line-height: 18px;
  color: #020618;
}

.appheader-wall {
  display: block;
  font-size: 14px;
  line-height: 20px;
  color: #62748e;
  max-width: 150px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.appheader-role {
  flex-shrink: 0;
  font-size: 12px;
  line-height: 16px;
  color: #62748e;
}
